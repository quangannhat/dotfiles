#!/usr/bin/env bash

sudo apt update
sudo apt install -y i3 stow emacs git ripgrep fd-find \
  x11-xserver-utils dex xss-lock i3lock network-manager-gnome \
  blueman ibus pulseaudio-utils flameshot rofi i3status alacritty

# brave-browser isn't in the default apt repos, add its repo first
if ! command -v brave-browser >/dev/null; then
  sudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg \
    https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg
  echo "deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main" \
    | sudo tee /etc/apt/sources.list.d/brave-browser-release.list
  sudo apt update
  sudo apt install -y brave-browser
fi

stow i3
stow emacs
stow asdf

if [ ! -d "$HOME/.config/emacs" ]; then
  git clone --depth 1 https://github.com/doomemacs/doomemacs "$HOME/.config/emacs"
  "$HOME/.config/emacs/bin/doom" install
fi

# asdf is built from source against a manually installed Go toolchain
GO_VERSION=1.26.2
if ! command -v go >/dev/null; then
  curl -fsSLo /tmp/go.tar.gz "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz"
  sudo tar -C /usr/local -xzf /tmp/go.tar.gz
  rm /tmp/go.tar.gz
fi
grep -qF '/usr/local/go/bin' "$HOME/.bashrc" || echo 'export PATH=$PATH:/usr/local/go/bin' >> "$HOME/.bashrc"
export PATH=$PATH:/usr/local/go/bin

ASDF_INSTALL="$HOME/installs/asdf"
if [ ! -d "$ASDF_INSTALL" ]; then
  git clone --depth 1 https://github.com/asdf-vm/asdf.git "$ASDF_INSTALL"
  (cd "$ASDF_INSTALL" && go build -ldflags='-s' -o bin/asdf ./cmd/asdf)
fi

if ! grep -qF 'ASDF_INSTALL' "$HOME/.bashrc"; then
  cat >> "$HOME/.bashrc" <<'EOF'

# asdf
export ASDF_INSTALL="$HOME/installs/asdf"
export ASDF_DATA_DIR="$HOME/.asdf"
export PATH="$ASDF_INSTALL/bin:$ASDF_DATA_DIR/shims:$PATH"
EOF
fi
export ASDF_INSTALL="$HOME/installs/asdf"
export ASDF_DATA_DIR="$HOME/.asdf"
export PATH="$ASDF_INSTALL/bin:$ASDF_DATA_DIR/shims:$PATH"

asdf plugin add dotnet
asdf install dotnet 10.0.300

grep -qF 'DOTNET_ROOT' "$HOME/.bashrc" || echo 'export DOTNET_ROOT="$HOME/.asdf/installs/dotnet/10.0.300"' >> "$HOME/.bashrc"

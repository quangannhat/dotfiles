[global]
    monitor = 0
    follow = mouse

    width = 320
    height = 300
    origin = top-right
    offset = 20x20
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4
    indicate_hidden = yes

    transparency = 10
    corner_radius = 12
    gap_size = 6

    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 4
    frame_color = "#ff2e88"
    separator_color = frame
    sort = yes
    idle_threshold = 120

    font = FiraCode Nerd Font 13
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/wofi --dmenu -p dunst:
    browser = /usr/bin/xdg-open

    always_run_script = true
    title = Dunst
    class = Dunst

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#1a1a1aee"
    foreground = "#e0e0e0"
    frame_color = "#33ccff"
    timeout = 5

[urgency_normal]
    background = "#1a1a1aee"
    foreground = "#e0e0e0"
    frame_color = "#ff2e88"
    timeout = 8

[urgency_critical]
    background = "#1a1a1aee"
    foreground = "#e0e0e0"
    frame_color = "#ff3030"
    timeout = 0
